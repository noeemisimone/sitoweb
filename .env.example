# Copia questo file in ".env" e compila i valori reali.
# Il file .env NON va committato (è già in .gitignore); questo .env.example sì,
# come template per chi clona il progetto.

# Chiave segreta Flask (genera con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# URI del database (default consigliato: sqlite:///overview.db)
DATABASE_URI=sqlite:///overview.db

# Chiave API NASA APOD (ottienine una gratis su https://api.nasa.gov/)
NASA_API_KEY=

# Ambiente: development | production | testing
FLASK_ENV=development
